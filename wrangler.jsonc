{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-project",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "bun run build"
  }
}
